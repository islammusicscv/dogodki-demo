{
  "name": "dogodki-api",
  "version": "1.0.0",
  "private": true,
  "description": "Demo aplikacija Dogodki za predavanja pri predmetu Razvoj spletnih rešitev",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/main.js",
    "reset": "node -e \"require('fs').rmSync('dogodki.db', { force: true }); console.log('dogodki.db deleted: it is refilled from seed.json on the next start.')\""
  },
  "dependencies": {
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/typeorm": "12.0.1",
    "better-sqlite3": "12.11.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
